{
  "name": "vortex-browser",
  "version": "1.0.0",
  "description": "Vortex Browser",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.vortex.browser",
    "productName": "Vortex Browser",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "logo2.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "logo2.ico",
      "uninstallerIcon": "logo2.ico",
      "shortcutName": "Vortex Browser"
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.6.4",
    "electron-reload": "^3.2.5"
  }
}